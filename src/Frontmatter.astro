---
import { type SchemaMeta } from './integration';

type Props = {
	blocks?: SchemaMeta[];
	callback?: (data: SchemaMeta, i: number) => Record<string, unknown>;
};

const { blocks, callback } = Astro.props;
const components = (await import('virtual:astro-frontmatter-cms')).default;
---

{
	blocks?.map(async (block, i) => {
		const Component = components[block.type];

		if (Component == null) {
			return <div>Unable to resolve frontmatter component</div>;
		} else {
			return <Component {...block} {...callback?.(block, i)} />;
		}
	})
}
